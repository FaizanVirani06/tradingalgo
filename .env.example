# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# --- EODHD (research/backtest data) ---
EODHD_API_KEY=

# --- TopstepX / ProjectX Gateway (live trading) ---
TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
# Optional -- auto-resolved from your active accounts if unset:
TOPSTEPX_ACCOUNT_ID=
# Optional overrides:
# TOPSTEPX_GATEWAY_URL=https://api.topstepx.com
# TOPSTEPX_ACCOUNT_SIZE=25000
# TOPSTEPX_DRY_RUN=true
